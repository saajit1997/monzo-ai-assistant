__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
.env
.vscode/
.idea/
.DS_Store
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/

# Phase 3+ generated artifacts — not Phase 1's committed CSV
data/processed/*
!data/processed/.gitkeep
data/analytics/*
!data/analytics/.gitkeep

# Exception: Phase 3's cleaned-content table is small (~1MB) and, unlike raw
# HTML, isn't regenerable from anything else committed to the repo (it's
# built from the gitignored data/raw/pages/*.html) — commit it so reviewers
# can see Phase 3's actual output without running the full live crawl.
!data/processed/pages.parquet

# Phase 6's retrieval index (~3MB) is likewise small and, unlike raw HTML,
# lets reviewers query the assistant's retrieval step immediately instead of
# waiting for the local embedding build — commit it too.
!data/processed/retrieval/
!data/processed/retrieval/*

# Phase 2: raw HTML dumps are bulky derived content, regenerable by
# re-running scripts/fetch_monzo_pages.py — only the small manifest CSV
# (data/raw/pages_manifest.csv) documenting the run is committed.
data/raw/pages/
